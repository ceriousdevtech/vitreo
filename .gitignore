# Every CMake build tree. build/ is the default one; the rest are ad-hoc
# variants (arch, instrumentation, or a one-off diagnostic) that come and go,
# and they all hold the same regenerable artifacts.
build*/

# Disk images from manager/package-dmg.sh.
/dist/
.cache/

# Python bytecode caches
__pycache__/
*.pyc

# Local performance and Oracle reports
perf-results/
cpu-perf-report.json
cpu-perf-report.csv

# Runtime checkpoint and trace captures
*.vck
*.pctrace

# Coverage profile output (cmake -DVITREO_COVERAGE=ON); the build-cov/ tree
# itself is covered by build*/ above.
*.profraw
*.profdata

# macOS Finder metadata. Appears in any directory the user browses, so this is
# unanchored; ten are already tracked and keep showing up as modifications
# until they are untracked (git rm --cached).
.DS_Store

# Xcode per-user state. Holds the local username, home directory, and machine
# model. Regenerated by Xcode; never publish it.
xcuserdata/
*.xcuserstate

# Stray compiler output from an ad-hoc `clang foo.c` in the tree.
a.out

# Untranslatable-shader dumps from dump_untranslatable_shader()
# (src/winapi/graphics/d3d11/d3d11_shader_translate.cpp). Written as
# failed_<stage>_<pid>_<seq>.dxbc under VITREO_LOG_DIR, or into the working
# directory when that is unset -- which is the repo root for a run started
# here. Gated on VITREO_D3D11_DIAG and regenerated by the next diagnostic run.
# Unanchored: the dump lands wherever the guest was launched from.
failed_*.dxbc

# Local Python environment. Recreate it; do not publish it.
.venv/

# Local documentation. Present on disk, not published.
.docs/

# Editor per-user settings.
.vscode/

# CTest scratch output from a ctest run in the source tree (ctest writes
# Testing/Temporary/LastTest.log wherever it runs).
/Testing/
