#
# cmake -DLIST=<file listing sources, one per line> -DOUT=<header> -DSTAMP=<file>
#       -P TranslatorHash.cmake
#
# Writes <header> defining VITREO_TRANSLATOR_HASH: the SHA-256 (first 32 hex
# digits) of every listed source file's name and contents, in list order.
# graphics::TranslationCache keys every entry on it, so a change to any
# shader translator source (or SPIRV-Cross) starts a new cache, and a rebuild
# that touches none of them keeps the old one. The header is rewritten only
# when the hash changes.

file(STRINGS "${LIST}" files)
set(material "")
foreach(f IN LISTS files)
    if(f STREQUAL "")
        continue()
    endif()
    get_filename_component(name "${f}" NAME)
    get_filename_component(dir "${f}" DIRECTORY)
    get_filename_component(parent "${dir}" NAME)
    file(SHA256 "${f}" h)
    string(APPEND material "${parent}/${name}:${h}\n")
endforeach()
string(SHA256 hash "${material}")
string(SUBSTRING "${hash}" 0 32 hash)
set(content "// Generated by cmake/TranslatorHash.cmake. Do not edit.\n#pragma once\n#define VITREO_TRANSLATOR_HASH \"${hash}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()
file(TOUCH "${STAMP}")
