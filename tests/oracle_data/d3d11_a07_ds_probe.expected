S3 pass=REPLACE  writemask=0f ref=a5 3c->35
S3 pass=INVERT   writemask=f0 ref=a5 3c->cc
S3 pass=INCR     writemask=0f ref=a5 3f->30
S3 pass=DECR     writemask=f0 ref=a5 30->20
S3 pass=ZERO     writemask=81 ref=a5 ff->7e
S3 pass=REPLACE  writemask=00 ref=a5 3c->3c
