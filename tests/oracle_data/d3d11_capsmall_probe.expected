== minprec ==
min16float 1 + 2^-12 = 1.00024414 (3f800800; fp16 would give 1)
min16float (1/3) * 3 = 1 (3f800000)
min10float 1/3 = 0.333333343 (3eaaaaab)
min16int 40000 * 3 = 120000
min16uint 40000 + 40000 = 80000
min16int -40000 - 7 = -40007
min16float 1/3 = 0.333333343 (3eaaaaab)
