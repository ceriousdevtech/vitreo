== order
default SearchPath -> cwd
default SearchPath(xcopy.exe) -> cwd
enable SetSearchPathMode(0x1) -> 1 err=0
safe SearchPath -> cwd
safe SearchPath(xcopy.exe) -> system
disable SetSearchPathMode(0x10000) -> 1 err=0
