enable-disable SetSearchPathMode(0x10001) -> 0 err=87
disable-permanent SetSearchPathMode(0x18000) -> 0 err=87
unknown-bit SetSearchPathMode(0x3) -> 0 err=87
high-bit SetSearchPathMode(0x80000001) -> 0 err=87
enable SetSearchPathMode(0x1) -> 1 err=0
enable-again SetSearchPathMode(0x1) -> 1 err=0
disable SetSearchPathMode(0x10000) -> 1 err=0
