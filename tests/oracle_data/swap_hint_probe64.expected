# swap_hint_probe64.expected - x86_64 build of swap_hint_probe.c on winoracle's interactive desktop (schtasks /it),
#   2026-10-27 (Task 13 fix round 1). The i686 build is identical except pointer-size.
# GDI Generic swaps by copy (PFD_SWAP_COPY; the back buffer keeps its contents). With glAddSwapHintRectWIN
#   rectangles pending, SwapBuffers copies only their union (window coordinates, bottom-left origin) and the
#   rest of the front buffer keeps its old contents; the pending rectangles are cleared by every SwapBuffers.
#   A rectangle of zero or negative width or height is ignored (no error); if no valid rectangle is pending the
#   whole buffer is copied. Rectangles survive glFlush, glFinish and wglMakeCurrent(NULL) / back. Inside glBegin
#   the call is INVALID_OPERATION and adds nothing. In a display list it is not compiled: GL_COMPILE drops it,
#   GL_COMPILE_AND_EXECUTE executes it, glCallList of such a list adds nothing.
# Task 13 fix round 2 (2026-10-28), lines after hint-across-makecurrent-*; every earlier line is unchanged. Three
#   points in/mid/out, mid = (120, 100) between the rectangles:
#   - disjoint rectangles: each rectangle is copied, not their bounding rectangle (hint-disjoint-rects-*: mid black).
#   - pending rectangles belong to the window: they survive a swap of another window (e1), the context visiting
#     another window and coming back (e2, drop-f5, -f6, -f9), another context becoming current on the window (e3,
#     e6, drop-f2, -f8), and a swap with no context current uses them (e5). A hint added on one window never
#     reaches another window's swap (second-window-*, hint-on-dc2-swap-dc1-*).
#   - UNEXPLAINED: e4 (hint under rc after a swap made under rcB, then rcB and rc current again) and
#     then-swap-dc1-* (hint on dc1, SwapBuffers(dc2) with rc current on dc1, rc visits dc2 and returns) both swap
#     whole, while drop-f1 .. -f9, which repeat each step alone, all keep the hint. Vitreo keeps it in both.
#   - single-buffered window: glAddSwapHintRectWIN is accepted without an error (also 100000 calls), but glFlush /
#     glFinish always show the whole buffer (hint-single-*); SwapBuffers on it with its own context current
#     returns TRUE (hint-single-swapbuffers; wgl_contract_probe: FALSE with no context or another one current).
setup pixelformat=4 flags=0x00008465 swap-copy=1 swap-exchange=0 hint-proc=1 pointer-size=8
hint-baseline-red front-gl=ff0000/ff0000 front-gdi=ff0000/ff0000 back=ff0000/ff0000 err=0x0000
hint-one-rect-green front-gl=00ff00/ff0000 front-gdi=00ff00/ff0000 back=00ff00/00ff00 err=0x0000
hint-next-swap-blue front-gl=0000ff/0000ff front-gdi=0000ff/0000ff back=0000ff/0000ff err=0x0000
hint-two-rects-yellow-over-black front-gl=ffff00/ffff00 front-gdi=ffff00/ffff00 back=ffff00/ffff00 err=0x0000
hint-out-rect-magenta-over-black front-gl=000000/ff00ff front-gdi=000000/ff00ff back=ff00ff/ff00ff err=0x0000
hint-finish-cyan-over-black front-gl=00ffff/000000 front-gdi=00ffff/000000 back=00ffff/00ffff err=0x0000
hint-flush-white-over-black front-gl=ffffff/000000 front-gdi=ffffff/000000 back=ffffff/ffffff err=0x0000
hint-zero-size-add err=0x0000
hint-zero-size-red-over-black front-gl=ff0000/ff0000 front-gdi=ff0000/ff0000 back=ff0000/ff0000 err=0x0000
hint-negative-width-add err=0x0000
hint-negative-width-green-over-black front-gl=00ff00/00ff00 front-gdi=00ff00/00ff00 back=00ff00/00ff00 err=0x0000
hint-huge-rect-blue-over-black front-gl=0000ff/0000ff front-gdi=0000ff/0000ff back=0000ff/0000ff err=0x0000
hint-zero-plus-rect-yellow-over-black front-gl=ffff00/000000 front-gdi=ffff00/000000 back=ffff00/ffff00 err=0x0000
hint-inside-begin err=0x0502
hint-in-list err=0x0000
hint-after-list-compile-magenta front-gl=ff00ff/ff00ff front-gdi=ff00ff/ff00ff back=ff00ff/ff00ff err=0x0000
hint-swap-right-after-compiling-green-over-black front-gl=00ff00/00ff00 front-gdi=00ff00/00ff00 back=00ff00/00ff00 err=0x0000
hint-swap-after-compile-and-execute-blue-over-black front-gl=0000ff/000000 front-gdi=0000ff/000000 back=0000ff/0000ff err=0x0000
hint-after-list-call-cyan-over-black front-gl=00ffff/00ffff front-gdi=00ffff/00ffff back=00ffff/00ffff err=0x0000
hint-refused-hint-white-over-black front-gl=ffffff/ffffff front-gdi=ffffff/ffffff back=ffffff/ffffff err=0x0000
hint-across-makecurrent-red-over-black front-gl=ff0000/000000 front-gdi=ff0000/000000 back=ff0000/ff0000 err=0x0000
hint-disjoint-rects-yellow-over-black front-gl=ffff00/000000/ffff00 front-gdi=ffff00/000000/ffff00 back=ffff00/ffff00/ffff00 err=0x0000
hint-l-shape-green-over-black front-gl=000000/000000/000000 front-gdi=000000/000000/000000 back=00ff00/00ff00/00ff00 err=0x0000
hint-second-window set=1 makecurrent=1
hint-second-window-red-over-black front-gl=ff0000/000000/000000 front-gdi=ff0000/000000/000000 back=ff0000/ff0000/ff0000 err=0x0000
hint-hint-on-dc2-swap-dc1-blue-over-black front-gl=0000ff/0000ff/0000ff front-gdi=0000ff/0000ff/0000ff back=0000ff/0000ff/0000ff err=0x0000
hint-dc2-after-black-swap note=the-black-swap-above-consumed-or-ignored-the-hint
hint-dc2-next-swap-cyan front-gl=00ffff/00ffff/00ffff front-gdi=00ffff/00ffff/00ffff back=00ffff/00ffff/00ffff err=0x0000
hint-swap-dc2-with-hint-on-dc1-white-over-black front-gl=ffffff/ffffff/ffffff front-gdi=ffffff/ffffff/ffffff back=ffffff/ffffff/ffffff err=0x0000
hint-then-swap-dc1-magenta-over-black front-gl=ff00ff/ff00ff/ff00ff front-gdi=ff00ff/ff00ff/ff00ff back=ff00ff/ff00ff/ff00ff err=0x0000
hint-single setup pixelformat=2 set=1 flags=0x0000807c doublebuffer=0 makecurrent=1 hint-proc=1 same-proc=1
hint-single-baseline-black gdi=000000/000000/000000 front-gl=000000/000000/000000 err=0x0000
hint-single-add err=0x0000
hint-single-hint-green-finish gdi=00ff00/00ff00/00ff00 front-gl=00ff00/00ff00/00ff00 err=0x0000
hint-single-no-new-hint-blue-finish gdi=0000ff/0000ff/0000ff front-gl=0000ff/0000ff/0000ff err=0x0000
hint-single-hint-red-flush gdi=ff0000/ff0000/ff0000 front-gl=ff0000/ff0000/ff0000 err=0x0000
