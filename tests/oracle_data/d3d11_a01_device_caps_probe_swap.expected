# ---------------------------------------------------------------------------
# winoracle "swap" and "swapfmt" modes, run from a scheduled task in the
# logged-on session (from ssh every swap chain is
# DXGI_ERROR_NOT_CURRENTLY_AVAILABLE 0x887a0022). Verdicts vs Vitreo (x64 and
# x86 identical):
#  sc desc NULL ppSwap NULL       WIN S_OK (device only)  VIT E_INVALIDARG  WRONG
#  sc desc valid ppSwap NULL      WIN S_OK (device only)  VIT E_INVALIDARG  WRONG
#  sc desc NULL ppSwap set        WIN S_OK, *ppSwap=NULL  VIT E_INVALIDARG  WRONG
#  sc desc NULL, only fl          WIN S_FALSE             VIT E_INVALIDARG  WRONG
#  sc WARP valid                  WIN S_OK                VIT DXGI_ERROR_UNSUPPORTED MISSING
#  sc format UNKNOWN              WIN E_INVALIDARG        VIT DXGI_ERROR_INVALID_CALL WRONG
#  sc FLIP_DISCARD BufferCount 1  WIN DXGI_ERROR_INVALID_CALL VIT S_OK      WRONG (area 11)
#  sc format R32G32B32A32_FLOAT   WIN E_INVALIDARG        VIT HOST ABORT     CRASH
#  swapfmt: Windows accepts back-buffer formats {10,24,28,29,87,89,91} for
#   bitblt and {10,24,28,87} for flip; anything else is E_INVALIDARG (bitblt)
#   or DXGI_ERROR_INVALID_CALL (flip). Vitreo:
#    2, 11, 26, 41 -> HOST ABORT: uncaught NSException 'CAMetalLayerInvalid'
#       "invalid pixel format 125/110/92/55" from -[CAMetalLayer
#       setPixelFormat:] (metal_swapchain.mm). The Metal format goes to the
#       layer unchecked.                                           CRASH
#    23, 27, 61 (typeless / R8) -> S_OK on both models               WRONG
#    29, 91 flip (sRGB flip back buffer) -> S_OK                     WRONG
#    89 bitblt -> DXGI_ERROR_INVALID_CALL (Windows S_OK)             MISSING
#    85, 88 -> DXGI_ERROR_INVALID_CALL (Windows E_INVALIDARG bitblt) WRONG code
#  all other lines match.
