## UAV range and truncation rules
(1,{rtv16},start 1,num 8,{uavA0,-..}) no conflict: rt rtv16 ds - uav - uavA0 - - - - - -
(0,-,-,start 7,num 2,{uavA0,uavA1}): rt ds - uav - - - - - - - uavA0
(0,-,-,start 8,num 1,{uavA0}): rt ds - uav - - - - - - - -
(1,{rtv16b},start 0,num 0): rt rtv16b ds - uav - -
(1,{rtv16b},start 0,num 1,{uavA0}): rt - ds - uav uavA0 -
KEEP_RTV duplicate uavs: rt rtv16b ds - uav - uavA1 -
